ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-5-5
DATABASE_URL=sqlite:///data/medixio.db
WA_SESSION_DB=data/wa_session/session.sqlite3
WHATSAPP_ENABLED=true
SCHEDULER_ENABLED=true
API_HOST=127.0.0.1
API_PORT=8000
# Required (16+ chars) when API_HOST is not localhost, e.g. in Docker: openssl rand -hex 24
ADMIN_TOKEN=
TZ_DISPLAY=America/Bogota
LOG_LEVEL=INFO
JSON_LOGS=false
OBSERVABILITY_DB=data/observability.db
OBSERVABILITY_RETENTION_DAYS=30
# Abuse / cost limits
RATE_MSGS_PER_10MIN=15
RATE_MSGS_PER_DAY=150
RATE_IMAGES_PER_DAY=10
RATE_SIGNUPS_PER_HOUR=20
MAX_MESSAGE_CHARS=2000
DAILY_TOKEN_BUDGET=2000000
